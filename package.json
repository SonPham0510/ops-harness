{
  "name": "ops-agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Agent harness for an operations assistant: LLM-tool loop, validation, retries, limits, approvals, traces.",
  "type": "module",
  "bin": {
    "ops-agent": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "ultracite check",
    "dev": "tsx src/cli/main.ts",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "verify": "bun run check && bun run typecheck && bun run test && node scripts/check-spec-coverage.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openrouter/sdk": "^1.3.33",
    "commander": "^15.0.0",
    "hono": "^4.13.9",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "7.12.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
