    {
      "id": "event-projection",
      "from": "event_log",
      "to": "projection",
      "label": "rebuild state + summary",
      "variant": "dashed"
    },
    {
      "id": "model-final-answer",
      "from": "model",
      "to": "answer",
      "label": "end_turn → trả lời",
      "variant": "emphasis",
      "role": "return"
    }
