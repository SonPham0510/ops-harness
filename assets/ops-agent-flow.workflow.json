  "cards": [
    {
      "dot": "cyan",
      "title": "Chạy thử",
      "items": [
        "Offline: bun run dev -- run \"checkout đang lỗi\" --model demo",
        "OpenRouter: export OPENROUTER_API_KEY trước khi chạy CLI"
      ]
    },
    {
      "dot": "amber",
      "title": "Điểm an toàn",
      "items": [
        "Tool chạy tuần tự; lỗi trả về model dưới dạng tool_result có isError.",
        "create_incident chỉ thực thi sau allow; JSONL giữ event để đọc trace."
      ]
    }
  ]
